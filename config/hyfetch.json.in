{
    "preset": "#ff3b30,#ff9500,#ffcc00,#34c759,#00c7be,#007aff,#af52de",
    "mode": "rgb",
    "auto_detect_light_dark": true,
    "light_dark": "dark",
    "lightness": 0.65,
    "color_align": {
        "mode": "horizontal"
    },
    "backend": "fastfetch",
    "args": "--structure Title:Separator:OS:Kernel:Uptime:WM:CPU:GPU:Memory:Disk:Battery:LocalIp",
    "distro": "arch_small",
    "pride_month_disable": true,
    "custom_ascii_path": "__HOME__/.config/hyfetch/arch_clean.txt",
    "custom_presets": null,
    "palette_glyph": null,
    "palette_type": null
}
